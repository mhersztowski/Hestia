# Serwer platformy: pliki (VFS), MQTT i uwierzytelnianie dla pozostałych aplikacji.
HESTIA_PLATFORM_PORT=4990

# Katalog danych — ścieżka względna liczona od katalogu aplikacji, nie od `cwd`.
HESTIA_PLATFORM_DATA_DIR=data

# Sekret do podpisywania tokenów. BEZ tej zmiennej serwer generuje losowy przy
# starcie, więc po każdym restarcie wszyscy są wylogowani — na produkcji ustaw.
HESTIA_JWT_SECRET=

# Pierwszy użytkownik zakładany przy pustej bazie (hasło do zmiany po zalogowaniu).
HESTIA_ADMIN_USER=admin
HESTIA_ADMIN_PASSWORD=admin
