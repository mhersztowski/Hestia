# The Drive application: browsing the platform's files, and editing them in
# place — Markdown, code, and whatever an assistant is asked to change.
DRIVE_PORT=4997
DRIVE_WEB_PORT=4998

# The platform's address (app/backend) — accounts and files come from there.
# This application has no users and no file store of its own.
HESTIA_PLATFORM_URL=http://localhost:4990
