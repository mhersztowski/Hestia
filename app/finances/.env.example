# Porty obu aplikacji trzymane w JEDNYM miejscu: `app/web/finances/vite.config.ts`
# czyta ten sam plik, więc zmiana portu nie wymaga ruszania dwóch konfiguracji.
HESTIA_BACKEND_PORT=4894
HESTIA_WEB_PORT=4895

# Katalog z danymi (plik `finanse.json`). Ścieżka względna liczona jest od
# katalogu aplikacji, a nie od `cwd` — inaczej `pnpm start` z korzenia repo
# zakładałby magazyn gdzie indziej niż `pnpm dev` z katalogu aplikacji.
HESTIA_DATA_DIR=data
