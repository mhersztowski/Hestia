{
  "name": "@hestia/ui-cad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cad2d": {
      "import": {
        "types": "./dist/cad2d.d.ts",
        "default": "./dist/cad2d.js"
      },
      "require": {
        "types": "./dist/cad2d.d.cts",
        "default": "./dist/cad2d.cjs"
      }
    },
    "./cad3d": {
      "import": {
        "types": "./dist/cad3d.d.ts",
        "default": "./dist/cad3d.js"
      },
      "require": {
        "types": "./dist/cad3d.d.cts",
        "default": "./dist/cad3d.cjs"
      }
    },
    "./icons/*": "./icons/*"
  },
  "files": [
    "dist",
    "icons"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^6.1.0",
    "@mui/material": "^6.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^6.1.0",
    "@mui/material": "^6.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.182.0",
    "jsdom": "^28.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@hestia/ui-core": "workspace:*",
    "opencascade.js": "2.0.0-beta.b5ff984",
    "three": "^0.182.0"
  }
}
